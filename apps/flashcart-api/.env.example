# FlashCart API configuration — PLACEHOLDERS ONLY. Copy to .env (gitignored) and fill in real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# local | test | production   (production enables strict guards: Secure cookies, origin-verify, no docs UI)
FLASHCART_ENV=local

# Local: mongodb://127.0.0.1:27017/?replicaSet=rs0  |  Atlas: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
FLASHCART_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
FLASHCART_MONGODB_DB=flashcart
FLASHCART_MONGODB_MAX_POOL_SIZE=20

# >= 32 characters each. Rotate JWT by moving the current value to *_PREVIOUS and setting a new one.
FLASHCART_JWT_SECRET=<generate-a-random-secret-of-at-least-32-chars>
FLASHCART_JWT_SECRET_PREVIOUS=
FLASHCART_WEBHOOK_SECRET=<generate-a-random-secret-of-at-least-32-chars>

# Production only: CloudFront injects this header; requests without it are rejected.
FLASHCART_ORIGIN_VERIFY_SECRET=
# Optional bearer token for GET /metrics (Prometheus scraping)
FLASHCART_METRICS_TOKEN=

# JSON list. Empty when the SPA and API share an origin (production via CloudFront, local via Vite proxy).
FLASHCART_CORS_ORIGINS=[]
# false ONLY for plain-http localhost development
FLASHCART_COOKIE_SECURE=false

FLASHCART_RATE_LIMIT_PER_MINUTE=300
FLASHCART_AUTH_RATE_LIMIT_PER_MINUTE=10

# Optional first-admin bootstrap (used only when no admin exists). Leave empty in shared environments.
FLASHCART_ADMIN_EMAIL=
FLASHCART_ADMIN_PASSWORD=
